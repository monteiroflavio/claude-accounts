#!/usr/bin/env bash
# claude-accounts-hook — UserPromptSubmit hook
#
# Runs on every message. Three jobs, in order:
#   1. Save whatever account is currently authenticated into
#      ~/.claude-accountsrc immediately — so a mid-session /login is
#      registered on your very next message, without waiting for the
#      session to end.
#   2. Force the credential store back to the account this directory resolves to
#      (its .claude-accounts file, or the rc file's default) for every
#      message. This is absolute: it always wins, even over a /login you
#      just did in this same session — a session's messages only ever use
#      its assigned account. Point .claude-accounts at the new account
#      yourself if you want it used here.
#   3. Report which account (and organization) is actually active via the
#      hook's systemMessage field, so the CLI's own (often stale) identity
#      display isn't the only signal — this is a UI-level notice, not
#      conversation context, so it doesn't cost tokens or clutter the
#      transcript on every turn.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./claude-accounts-lib.sh
source "$SCRIPT_DIR/claude-accounts-lib.sh"

trap _unlock EXIT

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"

# --- 1. Save the currently authenticated account, right away -----------
live_email=$(_live_email) || true
if [[ -n "$live_email" ]]; then
  live_blob=$(_credential_read) || true
  if [[ -n "$live_blob" ]]; then
    _lock
    _rc_upsert "$live_email" "$live_blob"
    _unlock
    _debug "saved currently authenticated account '$live_email'"
  fi

  live_org=$(_live_org) || true
  if [[ -n "$live_org" ]]; then
    _lock
    _org_upsert "$live_email" "$live_org"
    _unlock
  fi
fi

# --- 2 & 3. Force this project's resolved account back into the credential store, --
#            and report which account is active.
email=$(_resolve_email "$PROJECT_DIR") || exit 0

blob=$(_lookup_blob "$email") || {
  _emit_system_message "claude-accounts: no saved credentials for '$email' yet"
  exit 0
}

if _blob_expired "$blob"; then
  _emit_system_message "claude-accounts: '$email' has expired — run 'claude' and /login again."
  exit 0
fi

_lock
_credential_write "$blob"
_unlock

org=$(_org_lookup "$email") || true
if [[ -n "$org" ]]; then
  _emit_system_message "claude-accounts: using $email ($org)"
else
  _emit_system_message "claude-accounts: using $email"
fi
