#!/usr/bin/env bash
# claude-accounts-session-end — SessionEnd hook
# Backstop for claude-accounts-hook's immediate save: covers the case
# where you /login and exit without sending another message (so the
# UserPromptSubmit hook never got a chance to run). Saves the currently
# authenticated account's credential-store token (and organization name) into
# ~/.claude-accountsrc / the org cache, keyed by its email.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./claude-accounts-lib.sh
source "$SCRIPT_DIR/claude-accounts-lib.sh"

trap _unlock EXIT

email=$(_live_email) || exit 0
blob=$(_credential_read) || exit 0
[[ -z "$blob" ]] && exit 0

_lock
_rc_upsert "$email" "$blob"
_debug "saved credentials for '$email' to $CLAUDE_ACCOUNTS_RC"
_unlock

org=$(_live_org) || true
if [[ -n "$org" ]]; then
  _lock
  _org_upsert "$email" "$org"
  _unlock
fi
